<h1>Speisekarte</h1>

<div class="container mt-4">
    <h2>Speisen</h2>
    <div class="row">
        {{#each speisen}}
            {{#if (eq kategorie "Speise")}}
                <div class="col-md-4 mb-4">
                    <h3>{{name}}</h3>
                    <p>{{beschreibung}}</p>
                    <p>{{preis}} €</p>
                </div>
            {{/if}}
        {{/each}}
    </div>

    <h2 class="mt-4">Getränke</h2>
    <div class="row">
        {{#each speisen}}
            {{#if (eq kategorie "Getränk")}}
                <div class="col-md-4 mb-4">
                    <h3>{{name}}</h3>
                    <p>{{beschreibung}}</p>
                    <p>{{preis}} €</p>
                </div>
            {{/if}}
        {{/each}}
    </div>

    <div class="bewertungsbereich mt-5">
        <h2>Bewerte uns</h2>
        <form id="bewertungsformular">
            <div class="bewertungsfeld mb-3">
                <label for="bewertungsname">Name:</label>
                <input
                    type="text"
                    id="bewertungsname"
                    name="name"
                    class="form-control"
                    maxlength="50"
                    placeholder="Dein Name"
                    required>
            </div>

            <div class="bewertungsfeld mb-3">
                <p>Bewertung:</p>
                <div class="sterne-auswahl">
                    <input type="radio" id="sterne-1" name="sterne" value="1" required>
                    <label for="sterne-1" aria-label="1 Stern">★</label>

                    <input type="radio" id="sterne-2" name="sterne" value="2">
                    <label for="sterne-2" aria-label="2 Sterne">★</label>

                    <input type="radio" id="sterne-3" name="sterne" value="3">
                    <label for="sterne-3" aria-label="3 Sterne">★</label>

                    <input type="radio" id="sterne-4" name="sterne" value="4">
                    <label for="sterne-4" aria-label="4 Sterne">★</label>

                    <input type="radio" id="sterne-5" name="sterne" value="5">
                    <label for="sterne-5" aria-label="5 Sterne">★</label>
                </div>
            </div>

            <div class="bewertungsfeld mb-3">
                <label for="bewertungskommentar">Kommentar:</label>
                <textarea
                    id="bewertungskommentar"
                    name="kommentar"
                    class="form-control"
                    rows="5"
                    maxlength="1000"
                    placeholder="Wie hat es dir bei uns gefallen?"
                    required>
                </textarea>
            </div>

            <button type="submit" id="bewertung-absenden" class="btn btn-primary">
                Bewertung abschicken
            </button>

            <p id="bewertung-meldung" class="mt-3" aria-live="polite"></p>
        </form>

        <div class="bewertungsanzeige mt-5">
            <h2>Bewertungen unserer Gäste</h2>
            <div id="bewertungsliste" data-admin="{{adminEingeloggt}}">
                <p>Bewertungen werden geladen ...</p>
            </div>

            <button
                type="button"
                id="mehr-bewertungen"
                class="btn btn-secondary mt-3"
                hidden>
                Mehr laden
            </button>
        </div>
    </div>
</div>