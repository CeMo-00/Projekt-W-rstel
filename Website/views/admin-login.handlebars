<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Admin-Login</h1>
        <form id="login-formular">
            <div class="mb-3">
                <label for="admin-username" class="form-label">
                    Benutzername:
                </label>

                <input
                    type="text"
                    id="admin-username"
                    name="username"
                    class="form-control"
                    required>
            </div>

            <div class="mb-3">
                <label for="admin-password" class="form-label">
                    Passwort:
                </label>

                <input
                    type="password"
                    id="admin-password"
                    name="password"
                    class="form-control"
                    required>
            </div>

            <button type="submit" class="btn btn-primary">
                Einloggen
            </button>

            <p id="login-meldung" class="text-danger mt-3"></p>
        </form>
    </div>
</div>